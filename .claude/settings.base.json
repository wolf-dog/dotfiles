{
  "env": {
    "CLAUDE_CODE_SHELL": "/bin/bash",
    "SHELL": "/bin/bash"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "plan"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "/bin/sh \"$HOME/.claude/hooks/statusline-context.sh\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-attribution-trailers.sh\"",
            "timeout": 10,
            "statusMessage": "checking trailers"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/restore-worktree-links.sh\"",
            "timeout": 15,
            "statusMessage": "restoring links on worktree"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  }
}
